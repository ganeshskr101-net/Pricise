# Pricise settings. Copy to .env (the setup scripts do this) and fill in only what you use.
# Everything here is optional: with no .env at all the backend runs in stub mode.
# Never commit .env. Values set in your shell override this file.

# --- Switches -------------------------------------------------------------------------------------------------
# Deal Agent: "stub" = scripted demo findings (default), "real" = backend/agents/deal.py (scripts/run.sh --real)
AGENT_DEAL=stub
# Demo-friendly timings for the Store Lab tools (true by default)
SAMPLE_MODE=true
# Timer test: seconds between its 3 fresh page loads (default 3 when SAMPLE_MODE=true, 120 otherwise)
TIMER_GAP_S=3
# Price Agent: "stub" = scripted Store B/C/D findings (default), "real" = backend/agents/price.py (with AGENT_ORCH=on, the Skeptic re-checks every best price)
AGENT_PRICE=stub
# Orchestrator: "off" = stub_server's own flow (default), "on" = backend/orchestrator.py (Skeptic, World Model, Scout page guard)
AGENT_ORCH=off
# Where Pricise data comes from: "fixture" = backend/data/catalog.py in memory (default), "zetaris" = Lightning SQL via Zetaris
# (falls back to the fixture if Zetaris fails)
DATA_SOURCE=fixture
# Trust Agent: "stub" = scripted "Shop safe?" rows (default), "real" = backend/agents/trust.py
AGENT_TRUST=stub
# Trust Agent: let the Nemotron fast lane reword the reasons in plain English (the verdict always comes from rules)
TRUST_LLM_SUMMARY=false
# Trust Agent: pin "today" for domain age (YYYY-MM-DD). Store Lab stores already pin it in about.json ("as_of")
TRUST_AS_OF=
# Trust Agent: seconds per store fetch (default 3, capped at 8)
TRUST_HTTP_TIMEOUT=3
# Trust Agent: extra manufacturer photos for the copied-photo check, comma-separated repo paths or URLs (empty = storelab/_official only)
TRUST_OFFICIAL_IMAGES=
# Path to a Chromium/Chrome binary for the hidden browser. Needed on Windows (Playwright's cache isn't searched there),
# e.g. %LOCALAPPDATA%\ms-playwright\chromium-<version>\chrome-win64\chrome.exe
PLAYWRIGHT_CHROMIUM_PATH=

# --- Meterless Nightshift (every model call goes through backend/llm/meterless.py) ------------------------------
# OpenAI-compatible base URL of your Nightshift runtime, e.g. http://localhost:PORT/v1
METERLESS_BASE_URL=http://localhost:REPLACE_ME/v1
# Runtime token for Nightshift (secret)
METERLESS_RUNTIME_TOKEN=replace-me
# Model id for the fast Nemotron lane (agents: fee labels, chat)
NEMOTRON_FAST_MODEL=replace-with-your-fast-nemotron-model-id
# Model id for the deep Nemotron lane (Skeptic)
NEMOTRON_DEEP_MODEL=replace-with-your-deep-nemotron-model-id

# --- Zetaris (read by backend/data/zetaris.py; check with: .venv/bin/python scripts/check_zetaris.py) -----------------
# REST endpoint of your local Zetaris (Docker)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Zetaris API key (secret)
ZETARIS_API_KEY=replace-me
# Zetaris organisation id, sent as X-Org-ID
ZETARIS_ORG_ID=replace-me

# Zetaris datasource that holds the Pricise tables (created by scripts/register_zetaris.py)
ZETARIS_DATASOURCE=pricise_pg

# --- Pricise Postgres (docker-compose.pricise.yml): the data Zetaris queries; also where wishlist/findings writes go -------
PRICISE_PG_HOST=localhost
PRICISE_PG_PORT=5433
PRICISE_PG_DB=pricise
PRICISE_PG_USER=pricise
# Choose any long random password (secret)
PRICISE_PG_PASSWORD=replace-me
# How Zetaris (inside Docker) reaches this database
PRICISE_PG_ZETARIS_HOST=host.docker.internal

# --- World Model sidecar (shared finding state, used when AGENT_ORCH=on; optional) ------------------------------------
WORLD_MODEL_URL=http://127.0.0.1:8788
# H-MEM notes folder, read by the sidecar and backend/engines/hmem.py (empty = <repo>/.pricise-data/memory/, git-ignored)
HMEM_DATA_DIR=
# Wishlist watch checkpoints folder, read by backend/watch.py (empty = <repo>/.pricise-data/watch/, git-ignored)
WATCH_DATA_DIR=
# Markovian: max milliseconds the sidecar waits for each chunk (default 60000; 100-60000)
MARKOVIAN_CHUNK_TIMEOUT_MS=60000

# --- Not read yet ----------------------------------------------------------------------------------------------
# Where the extension finds the backend (the extension currently has http://localhost:8787 built in)
BACKEND_URL=http://localhost:8787
# Copied-photo check: images per store. A constant in backend/tools/photo_match.py (8); this value is NOT read
MAX_IMAGES_PER_STORE=8
