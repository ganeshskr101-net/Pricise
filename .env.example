# Copy to .env and fill in. Never commit .env.
BACKEND_URL=http://localhost:8787
SAMPLE_MODE=true

# Meterless Nightshift (all model calls go through backend/llm/meterless.py)
METERLESS_BASE_URL=http://localhost:REPLACE_ME/v1
METERLESS_RUNTIME_TOKEN=replace-me
NEMOTRON_FAST_MODEL=replace-with-your-fast-nemotron-model-id
NEMOTRON_DEEP_MODEL=replace-with-your-deep-nemotron-model-id

# Zetaris (local Docker)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace-me
ZETARIS_ORG_ID=replace-me
