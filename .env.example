# Copy to .env and fill in. Never commit .env.
BACKEND_URL=http://localhost:8787
SAMPLE_MODE=true

# Meterless Nightshift (all model calls go through backend/llm/meterless.py)
METERLESS_BASE_URL=http://localhost:REPLACE_ME/v1
METERLESS_RUNTIME_TOKEN=replace-me
NEMOTRON_FAST_MODEL=replace-with-your-fast-nemotron-model-id
NEMOTRON_DEEP_MODEL=replace-with-your-deep-nemotron-model-id

# Zetaris (local Docker)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace-me
ZETARIS_ORG_ID=replace-me

# Agents: stub (scripted, default) or real, swapped in one at a time
AGENT_DEAL=stub
# Deal Agent timer test: seconds between the 3 fresh visits (default 20 in SAMPLE_MODE, 120 otherwise; 3 is enough for a fast demo)
TIMER_GAP_S=20
# Optional: Chromium for the hidden browser if Playwright's own download is missing (else the newest cached one is used)
PLAYWRIGHT_CHROMIUM_PATH=
