{
  "manifest_version": 3,
  "name": "Pricise",
  "version": "0.1.0",
  "description": "Checks any product page before you buy: Shop safe? Honest deal? Best safe price?",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Check this page with Pricise", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "web_accessible_resources": [{ "resources": ["icons/logo.svg"], "matches": ["http://*/*", "https://*/*"] }],
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "notifications", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://localhost:8787/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content/quick-card.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle" }
  ]
}
