{
  "name": "default",
  "version": 1,
  "note": "General injection patterns (Scout spec docs/risk-and-policy.md, layer 1). Read by scout/guard.ts AND by the Python fallback (backend/engines/scout.py), so keep every pattern in the regex subset both engines share: no lookbehind, no named groups. Flags: i always, m when listed.",
  "patterns": [
    { "id": "override-instructions", "kind": "pattern", "severity": "block",
      "pattern": "\\b(?:ignore|disregard|forget|override|bypass)\\b[^.\\n]{0,40}?\\b(?:previous|prior|above|earlier|preceding|all|any|the|your|these|those|other)\\b[^.\\n]{0,20}?\\b(?:instructions?|prompts?|rules|directions|guidelines|directives|guardrails)\\b" },
    { "id": "override-previous", "kind": "pattern", "severity": "block",
      "pattern": "\\b(?:ignore|disregard)\\s+(?:all\\s+)?(?:previous|prior|above|earlier)\\b" },
    { "id": "override-principal", "kind": "pattern", "severity": "block",
      "pattern": "\\b(?:ignore|disregard)\\s+(?:the|your)\\s+(?:user|shopper|customer|system|developer|operator)\\b" },
    { "id": "new-instructions", "kind": "pattern", "severity": "warn",
      "pattern": "\\bnew (?:instructions|rules|system prompt)\\s*:" },
    { "id": "unrestricted-mode", "kind": "role-drift", "severity": "block",
      "pattern": "\\b(?:enter|enable|switch to|activate|in|into)\\s+(?:unrestricted|jailbreak|jailbroken|god|dan|uncensored)\\s+mode\\b" },
    { "id": "you-are-now", "kind": "role-drift", "severity": "block",
      "pattern": "\\byou are now (?:an? |the |my |in )?(?:unrestricted|jailbroken|uncensored|admin|administrator|root|system|superuser|different ai)\\b" },
    { "id": "you-are-admin", "kind": "role-drift", "severity": "block",
      "pattern": "\\byou are (?:an? |the )?(?:database |system )?(?:admin|administrator|root user|superuser)\\b" },
    { "id": "pretend-role", "kind": "role-drift", "severity": "block",
      "pattern": "\\bpretend (?:to be|you are|that you are)\\s+(?:the |an? )?(?:system|admin|administrator|root|developer|operator|database)\\b" },
    { "id": "act-as-role", "kind": "role-drift", "severity": "block",
      "pattern": "\\b(?:act|behave|respond) as (?:an? |the )?(?:system|admin|administrator|root|developer|unrestricted|jailbroken)\\b" },
    { "id": "role-tags", "kind": "embedded-control", "severity": "block",
      "pattern": "<\\s*/?\\s*(?:system|user|assistant|developer|tool)\\s*>" },
    { "id": "inst-tags", "kind": "embedded-control", "severity": "block",
      "pattern": "\\[/?INST\\]|<<\\s*/?SYS\\s*>>|<\\|(?:im_start|im_end|system|user|assistant|endoftext)\\|>" },
    { "id": "secret-exfiltration", "kind": "pattern", "severity": "block",
      "pattern": "\\b(?:reveal|print|dump|leak|expose|output|repeat|give me)\\b[^.\\n]{0,30}?\\b(?:api[ _-]?keys?|credentials|passwords?|secrets?|access tokens?|auth tokens?|private keys?|system prompt|hidden prompt|your instructions)\\b" },
    { "id": "privilege-grant", "kind": "pattern", "severity": "block",
      "pattern": "\\bgrant (?:me|us|myself)\\b[^.\\n]{0,25}?\\b(?:admin|root|access|privileges?|permissions?|rights)\\b|\\bgrant\\s+(?:full\\s+)?admin\\b" },
    { "id": "bidi-override", "kind": "unicode", "severity": "block",
      "pattern": "[\\u202D\\u202E]" },
    { "id": "bidi-embedding", "kind": "unicode", "severity": "warn",
      "pattern": "[\\u202A-\\u202C]" },
    { "id": "bidi-escape-literal", "kind": "unicode", "severity": "block",
      "pattern": "\\\\u(?:202[a-e]|206[6-9])" },
    { "id": "markdown-imperative", "kind": "pattern", "severity": "warn", "flags": "m",
      "pattern": "^\\s*#{1,6}\\s*(?:important|attention|urgent|system|instructions?)\\b" }
  ]
}
